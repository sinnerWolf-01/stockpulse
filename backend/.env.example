# Copy this file to .env.local and replace the blank values.
# Do not commit .env.local or share the API key/cookie.

LLM_BASE_URL=https://litellm-qc.zycus.net
LLM_API_KEY=
LLM_MODEL=
LLM_PRODUCT=
LLM_COOKIE=

# Keep both strategies on rule until the LLM values above are configured.
STOCKPULSE_PRICING_STRATEGY=rule
STOCKPULSE_REORDER_STRATEGY=rule

# Backend HTTP port.
SERVER_PORT=8080